rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection — only admins can read/write
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Companies — anyone authenticated can read; only admins can write
    match /companies/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Models — anyone authenticated can read; only admins can write
    match /models/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Problems/Solutions — anyone authenticated can read; only admins can write
    match /problems/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
